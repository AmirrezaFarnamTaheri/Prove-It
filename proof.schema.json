{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:prove-it:proof-ledger:1.0",
  "title": "Prove It Proof Ledger",
  "description": "Durable local evidence ledger for one Prove It proof session.",
  "type": "object",
  "required": [
    "schema_version",
    "session_id",
    "task",
    "workspace",
    "created_at",
    "updated_at",
    "source_state",
    "criteria",
    "evidence"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "session_id": {"type": "string", "minLength": 1},
    "task": {"type": "string", "minLength": 1},
    "workspace": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "source_state": {
      "type": "object",
      "required": ["kind", "workspace", "captured_at", "git"],
      "properties": {
        "kind": {"enum": ["git", "directory"]},
        "workspace": {"type": "string", "minLength": 1},
        "captured_at": {"type": "string", "format": "date-time"},
        "git": {"type": "boolean"},
        "git_root": {"type": ["string", "null"]},
        "commit": {"type": ["string", "null"]},
        "branch": {"type": ["string", "null"]},
        "dirty": {"type": ["boolean", "null"]},
        "fingerprint": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": true
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "statement", "override_state", "override_reason", "evidence_ids"],
        "properties": {
          "id": {"type": "string", "pattern": "^AC-(?:[A-Za-z0-9._-]+|[0-9]{2,})$"},
          "statement": {"type": "string", "minLength": 1},
          "override_state": {"type": ["string", "null"], "enum": [null, "blocked", "waived"]},
          "override_reason": {"type": ["string", "null"]},
          "evidence_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^EV-[0-9]{3,}$"}
          }
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "criterion_ids",
          "kind",
          "relation",
          "strength",
          "provenance",
          "summary",
          "observed_at"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^EV-[0-9]{3,}$"},
          "criterion_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^AC-(?:[A-Za-z0-9._-]+|[0-9]{2,})$"}
          },
          "kind": {"type": "string", "minLength": 1},
          "relation": {"enum": ["supports", "contradicts", "context"]},
          "strength": {"enum": ["verified", "strongly_inferred", "assumed", "unknown"]},
          "provenance": {"enum": ["server-observed", "agent-reported"]},
          "summary": {"type": "string", "minLength": 1},
          "observed_at": {"type": "string", "format": "date-time"},
          "path": {"type": "string"},
          "line_start": {"type": ["integer", "null"], "minimum": 1},
          "line_end": {"type": ["integer", "null"], "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "excerpt": {"type": ["string", "null"]},
          "command": {"type": "string"},
          "argv": {"type": "array", "items": {"type": "string"}},
          "cwd": {"type": "string"},
          "exit_code": {"type": "integer"},
          "timed_out": {"type": "boolean"},
          "duration_ms": {"type": "integer", "minimum": 0},
          "output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "output_excerpt": {"type": "string"},
          "workspace_fingerprint": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "details": {"type": "object"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
